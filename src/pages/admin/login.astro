---
import '../../styles/global.css';

const error = Astro.url.searchParams.get('error');
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Admin Login | Portfolio</title>
		<link rel="icon" type="image/webp+xml" href="/favicon.webp" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="login-page">
  <div class="container">
    <div class="login-card glass-card">
      <h1 class="theme-text">Admin Access</h1>
      <p>Enter your password to manage your portfolio.</p>
      
      <form action="/api/auth/login" method="POST" class="login-form">
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required />
        </div>
        {error && <p class="error-message">Invalid password. Please try again.</p>}
        <button type="submit" class="btn primary large">Login</button>
      </form>
    </div>
  </div>

  <style>
    .login-page {
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--bg-secondary);
    }
    .login-card {
      max-width: 400px;
      padding: 3rem;
      text-align: center;
    }
    h1 { margin-bottom: 1rem; }
    p { margin-bottom: 2rem; color: var(--text-secondary); }
    .form-group {
      text-align: left;
      margin-bottom: 1.5rem;
    }
    label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: 600;
      font-size: 0.9rem;
    }
    input {
      width: 100%;
      padding: 0.75rem;
      border: 2px solid var(--border);
      background: white;
      font-size: 1rem;
    }
    .error-message {
      color: #dc2626;
      font-size: 0.875rem;
      margin-bottom: 1.5rem;
    }
  </style>
</body>
</html>
