---
import { getConfig } from '../data/config';
import Badge from './Badge.astro';

const config = await getConfig();
---

<section id="home" class="hero-section">
  <div class="container">
    <div class="hero-content parallax">
      <div class="hero-header">
        <img src="https://github.com/r-rajaneesh.png" alt={config.name} class="profile-photo reveal" />
        <div class="hero-top">
          <h1 class="reveal name">{config.name}</h1>
          <Badge status={config.status} />
        </div>
      </div>
      <p class="reveal title theme-text">{config.title}</p>
      <p class="reveal bio">{config.bio}</p>
      <div class="reveal cta">
        <a href="#contact" class="btn primary">Get in Touch</a>
        <a href="#projects" class="btn secondary">View Projects</a>
      </div>
    </div>
  </div>
</section>

<script>
  import anime from 'animejs';

  // Entry animations
  window.addEventListener('DOMContentLoaded', () => {
    anime({
      targets: '.profile-photo',
      opacity: [0, 1],
      scale: [0.8, 1],
      duration: 1200,
      easing: 'easeOutExpo'
    });

    anime({
      targets: '.name',
      opacity: [0, 1],
      translateX: [-50, 0],
      duration: 1500,
      easing: 'easeOutExpo',
      delay: 200
    });
  });

  // Parallax effect on scroll
  window.addEventListener('scroll', () => {
    const scrolled = window.pageYOffset;
    const parallaxEl = document.querySelector('.parallax');
    if (parallaxEl) {
      anime({
        targets: '.parallax',
        translateY: scrolled * 0.3,
        duration: 0,
        easing: 'linear'
      });
      
      anime({
        targets: '.profile-photo',
        rotate: scrolled * 0.05,
        duration: 0,
        easing: 'linear'
      });
    }
  });
</script>

<style>
  .hero-section {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding-top: 8rem;
    overflow: hidden;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .profile-photo {
    width: 120px;
    height: 120px;
    border: 4px solid var(--accent);
    box-shadow: var(--shadow-lg);
    object-fit: cover;
  }

  .hero-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  h1.name {
    font-size: 4rem;
    line-height: 1.1;
  }

  .title {
    font-size: 2.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .bio {
    font-size: 1.25rem;
    color: var(--text-secondary);
    margin-bottom: 2.5rem;
    max-width: 600px;
  }

  .cta {
    display: flex;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .hero-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    h1.name { font-size: 3rem; }
    .profile-photo { width: 100px; height: 100px; }
  }
</style>
